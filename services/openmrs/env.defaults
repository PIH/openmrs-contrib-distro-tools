# OPENMRS_IMAGE_NAME has no default: the instance must set it (compose.yaml requires it).
OPENMRS_IMAGE_TAG=latest
OPENMRS_PIH_CONFIG=
OPENMRS_HTTP_PORT=8080
OPENMRS_DEBUG_PORT=1044
OPENMRS_MEMORY_LIMIT=4g
OPENMRS_JAVA_MEMORY_OPTS=-Xms512m -Xmx2g -XX:NewSize=128m
OPENMRS_ACTIVITYLOG_ENABLED=false
# Paths in openmrs-data the nightly backup leaves out, space-separated, relative to the volume (the
# distribution artifacts are always left out).
OPENMRS_DATA_BACKUP_EXCLUDES=
