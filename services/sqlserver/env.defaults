# SQLSERVER_SA_PASSWORD has no default: the instance must set it, the sa password (8+ characters,
# with 3 of upper case, lower case, digits and symbols).
SQLSERVER_IMAGE_TAG=2025-latest
# For reaching SQL Server from outside Docker (reports, the data team); the instance's services use 1433.
SQLSERVER_PUBLISHED_PORT=1433
# Databases to create (space-separated); a login's own databases are created too.
SQLSERVER_DATABASES=
SQLSERVER_MEMORY_MB=2048
SQLSERVER_TEMPDB_FILES=4
SQLSERVER_MEMORY_LIMIT=3g
# Logins: SQLSERVER_LOGIN_<ID>_USER, _PASSWORD, _DATABASES (space-separated), _ROLE (default db_owner)
