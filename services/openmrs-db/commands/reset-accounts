#!/bin/bash
# Sets the MySQL accounts and OpenMRS's connection settings to the passwords now in the env files.
# Run it after rotating them: changing the files alone changes neither: MySQL takes
# OPENMRS_DB_ROOT_PASSWORD/OPENMRS_DB_PASSWORD only when it sets up an empty data directory, and
# openmrs-core 2.6+ applies its connection settings only on its first install. The instance is
# stopped for it and started again. Run through pihx, which holds the instance lock and sets the
# environment (pihx/script.py).
set -euo pipefail
volume="${SERVICE_NAME}_db-data"
docker volume inspect "$volume" >/dev/null 2>&1 || {
    echo "error: $volume doesn't exist -- nothing to reset" >&2
    exit 1
}
# All profiles, as pihx's stop: a job's kept container (PETL) would otherwise outlive the network
# it's attached to, and its next run fail.
docker compose --project-directory "$PIHX_INSTANCE_DIR" --profile '*' down --remove-orphans
MYSQL_ROOT_PASSWORD="$OPENMRS_DB_ROOT_PASSWORD" MYSQL_PASSWORD="$OPENMRS_DB_PASSWORD" \
    "$PIHX_TOOLS/utils/reset-mysql-accounts.sh" --volume="$volume" \
    --image="$OPENMRS_DB_IMAGE_NAME:$OPENMRS_DB_IMAGE_TAG" --user="$OPENMRS_DB_USER"
if docker volume inspect "${SERVICE_NAME}_openmrs-data" >/dev/null 2>&1; then
    printf 'connection.username=%s\nconnection.password=%s\n' "$OPENMRS_DB_USER" "$OPENMRS_DB_PASSWORD" |
        "$PIHX_TOOLS/utils/runtime-properties.sh" --volume="${SERVICE_NAME}_openmrs-data" --set
fi
# pihx's own start (without the lock, which this command holds): brings the instance up and checks
# every service's setup containers.
PYTHONPATH="$PIHX_TOOLS" PYTHONDONTWRITEBYTECODE=1 python3 -m pihx "$PIHX_INSTANCE" _start
