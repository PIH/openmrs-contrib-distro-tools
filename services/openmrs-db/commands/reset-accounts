#!/bin/bash
# Sets the MySQL accounts to the passwords now in the env files. Run it after rotating them: MySQL
# takes OPENMRS_DB_ROOT_PASSWORD/OPENMRS_DB_PASSWORD only when it sets up an empty data directory.
# OpenMRS needs nothing: openmrs-core 2.8.11+ writes the connection settings from the environment into
# its runtime properties file on every start (TRUNK-6832). The instance is stopped for it and started
# again. Run through pihx, which holds the instance lock and sets the environment (pihx/script.py).
set -euo pipefail
volume="${SERVICE_NAME}_db-data"
docker volume inspect "$volume" >/dev/null 2>&1 || {
    echo "error: $volume doesn't exist -- nothing to reset" >&2
    exit 1
}
# All profiles, as pihx's stop: a job's kept container (PETL) would otherwise outlive the network
# it's attached to, and its next run fail.
docker compose --project-directory "$PIHX_INSTANCE_DIR" --profile '*' down --remove-orphans
MYSQL_ROOT_PASSWORD="$OPENMRS_DB_ROOT_PASSWORD" MYSQL_PASSWORD="$OPENMRS_DB_PASSWORD" \
    "$PIHX_TOOLS/utils/reset-mysql-accounts.sh" --volume="$volume" \
    --image="$OPENMRS_DB_IMAGE_NAME:$OPENMRS_DB_IMAGE_TAG" --user="$OPENMRS_DB_USER"
# pihx's own start (without the lock, which this command holds): brings the instance up and checks
# every service's setup containers.
python3 -m pihx "$PIHX_INSTANCE" _start
