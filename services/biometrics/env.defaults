# See compose.yaml. The image is private: the host needs `docker login ghcr.io`.
# BIOMETRICS_LICENSE_BASE64, the Neurotechnology license file base64-encoded (base64 -w0 <file>.lic),
# has no default: the instance must set it.
BIOMETRICS_IMAGE_NAME=ghcr.io/pih/pih-biometrics
BIOMETRICS_IMAGE_TAG=latest
BIOMETRICS_MATCHING_THRESHOLD=72
BIOMETRICS_MATCHING_SPEED=LOW
BIOMETRICS_TEMPLATE_SIZE=LARGE
