# See compose.yaml for what these are used for. These have no default: the instance must set them:
# ADVAPACS_MEDIATOR_INBOUND_SECRET, ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_PASSWORD,
# ADVAPACS_MEDIATOR_OPENMRS_USERNAME, ADVAPACS_MEDIATOR_OPENMRS_PASSWORD,
# ADVAPACS_MEDIATOR_ADVAPACS_CLIENT_ID, ADVAPACS_MEDIATOR_ADVAPACS_CLIENT_SECRET and
# ADVAPACS_MEDIATOR_PATIENT_IDENTIFIER_SYSTEM.
ADVAPACS_MEDIATOR_IMAGE_NAME=partnersinhealth/openhim-advapacs-mediator
ADVAPACS_MEDIATOR_IMAGE_TAG=latest
ADVAPACS_MEDIATOR_MEMORY_LIMIT=256m
ADVAPACS_MEDIATOR_LOG_LEVEL=info
ADVAPACS_MEDIATOR_ORDER_INGESTION_MODE=poll
ADVAPACS_MEDIATOR_ORDER_POLL_INTERVAL_MS=15000
ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_ID=openmrs
ADVAPACS_MEDIATOR_OPENMRS_BASE_URL=http://openmrs:8080/openmrs
ADVAPACS_MEDIATOR_OPENMRS_FHIR_PATH=/ws/fhir2/R4
ADVAPACS_MEDIATOR_ADVAPACS_BASE_URL=https://usa1.api.integration.advapacs.com/fhir/R5
ADVAPACS_MEDIATOR_PRACTITIONER_IDENTIFIER_SYSTEM=
# For AdvaPACS's result webhook, not served yet (compose.yaml).
ADVAPACS_MEDIATOR_ADVAPACS_WEBHOOK_SECRET=
