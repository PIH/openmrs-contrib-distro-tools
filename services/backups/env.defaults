# BACKUP_ARCHIVE_PASSWORD has no default: the instance must set it (compose.yaml requires it).
# Run folders are <prefix>_<UTC timestamp>; empty: the instance's name.
BACKUP_PREFIX=
# Cron expressions, in the instance's TZ.
BACKUP_SCHEDULE=30 1 * * *
BACKUP_UPLOAD_SCHEDULE=15 * * * *
# Complete runs kept in the volume (uploaded ones, when uploading); all keeps every run.
BACKUP_KEEP_LOCAL=3
# Where complete runs are uploaded: empty for nowhere (runs stay in the volume), or azure (BACKUP_AZURE_*).
BACKUP_UPLOAD=
# For azure: runs go to <url>/<path>/<run>/. The SAS token needs write and list on BACKUP_AZURE_PATH.
BACKUP_AZURE_URL=
BACKUP_AZURE_PATH=
BACKUP_AZURE_SAS=
# Free space a run must leave on the disk, beyond the newest run's size: bytes, or with a K, M or G suffix.
BACKUP_MIN_FREE=2G
BACKUP_MEMORY_LIMIT=1g
