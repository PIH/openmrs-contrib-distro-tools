#!/bin/bash
# Sets a DHIS2 user's password in the database, and makes sure the account can log in with it.
#
# Usage: pihx <instance> dhis2 reset-password [<username>]   (default admin)
#   The password is asked for twice, without echoing, or read as one line from stdin when it isn't a
#   terminal: printf '%s\n' "$pw" | pihx <instance> dhis2 reset-password <username>
#
# For an instance restored from another server, whose logins nobody here has. DHIS2 is stopped first
# and left stopped (start it with `pihx <instance> start`): a running DHIS2 keeps the user it has
# loaded and writes it back, old password and all, at that user's next login. A DHIS2 still starting
# (perhaps migrating) is refused instead. dhis2-db is started if it isn't running. The account is
# also enabled, and LDAP/external login and two-factor are turned off for it, so nothing else stands
# in the way of the new password. The password is hashed with bcrypt (cost 10, $2a$, which every
# listed DHIS2 version accepts) by Postgres's pgcrypto (the database's own if it has one, else one
# made in a schema of its own), in a transaction that's rolled back, so DHIS2's database gains no
# extension; the hash is then written in a second one. The user is found in `users` (DHIS2 up to
# 2.40) or `userinfo` (from 2.41), whichever has the username and password columns. Neither the
# password nor the hash is ever on a command line or printed.
set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }
compose() { docker compose --project-directory "$PIHX_INSTANCE_DIR" "$@"; }
# DEPLOY_FAILED and dhis2_still_starting.
source "$PIHX_TOOLS/services/dhis2/scripts/still-starting.sh"

user='admin'
case $# in
    0) ;;
    1) case "$1" in -*) die "unknown argument: $1 (usage: pihx $PIHX_INSTANCE dhis2 reset-password [<username>])" ;; esac
       user=$1 ;;
    *) die "usage: pihx $PIHX_INSTANCE dhis2 reset-password [<username>]" ;;
esac

if [ -t 0 ]; then
    read -rsp "New password for $user: " pw; echo >&2
    read -rsp "Again: " again; echo >&2
    [ "$pw" = "$again" ] || die "the two passwords differ"
else
    IFS= read -r pw || [ -n "${pw:-}" ] || die "no password on stdin"
fi
[ -n "$pw" ] || die "the password is empty"

if dhis2_still_starting; then
    die "$SERVICE_NAME-dhis2 is still starting: its migrations may be running, and stopping it could interrupt them. Wait until 'pihx $PIHX_INSTANCE status' shows it healthy (or its log shows it failed), then run this again."
fi
db="$SERVICE_NAME-dhis2-db"
if [ "$(docker inspect -f '{{.State.Running}}' "$db" 2>/dev/null)" != true ]; then
    compose up -d dhis2-db >/dev/null 2>&1 ||
        die "couldn't start dhis2-db (an instance never started or initialized has no database: pihx $PIHX_INSTANCE start, or initialize, first)"
fi
"$PIHX_TOOLS/utils/wait-for-healthy.sh" --container="$db" --timeout=600 >/dev/null || die "$db didn't become healthy"
compose stop dhis2 >/dev/null 2>&1

# The values reach psql through the environment (docker exec -e NAME passes the caller's value, and
# psql's \getenv reads it), never a command line.
export DHIS2_RESET_USER=$user DHIS2_RESET_PASSWORD=$pw
out=$(docker exec -i -e DHIS2_RESET_USER -e DHIS2_RESET_PASSWORD "$db" sh -c \
    'PGPASSWORD="$POSTGRES_PASSWORD" exec psql -X -q -A -t -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"' \
    2>&1 <<'SQL'
\getenv u DHIS2_RESET_USER
\getenv pw DHIS2_RESET_PASSWORD
-- One row always (\gset errors on none): the table, users before userinfo, or none.
SELECT max(c.table_name) AS t, count(*) > 0 AS has_t FROM information_schema.columns c
WHERE c.table_schema = 'public' AND c.table_name IN ('users', 'userinfo') AND c.column_name = 'password'
  AND EXISTS (SELECT 1 FROM information_schema.columns u WHERE u.table_schema = 'public'
              AND u.table_name = c.table_name AND u.column_name = 'username') \gset
\if :has_t
\else
\echo NO-USER-TABLE
\quit
\endif
SELECT count(*) = 1 AS found FROM :"t" WHERE username = :'u' \gset
\if :found
\else
\echo NO-SUCH-USER
\quit
\endif
SELECT bool_or(column_name = 'disabled') AS has_disabled, bool_or(column_name = 'externalauth') AS has_externalauth,
       bool_or(column_name = 'twofa') AS has_twofa, bool_or(column_name = 'twofactortype') AS has_twofactortype,
       bool_or(column_name = 'passwordlastupdated') AS has_updated
FROM information_schema.columns WHERE table_schema = 'public' AND table_name = :'t' \gset
SELECT count(*) > 0 AS has_pgcrypto, max(extnamespace::regnamespace::text) AS ns FROM pg_extension WHERE extname = 'pgcrypto' \gset
BEGIN;
\if :has_pgcrypto
\else
-- In a schema of its own: in public, its gen_random_uuid() would clash with the one DHIS2 2.43 defines.
CREATE SCHEMA pihx_reset_password;
CREATE EXTENSION pgcrypto WITH SCHEMA pihx_reset_password;
\set ns pihx_reset_password
\endif
SELECT :"ns".crypt(:'pw', :"ns".gen_salt('bf', 10)) AS hash \gset
ROLLBACK;
BEGIN;
UPDATE :"t" SET password = :'hash' WHERE username = :'u';
\if :has_updated
UPDATE :"t" SET passwordlastupdated = now() WHERE username = :'u';
\endif
\if :has_disabled
UPDATE :"t" SET disabled = false WHERE username = :'u';
\endif
\if :has_externalauth
UPDATE :"t" SET externalauth = false WHERE username = :'u';
\endif
\if :has_twofa
UPDATE :"t" SET twofa = false WHERE username = :'u';
\endif
\if :has_twofactortype
UPDATE :"t" SET twofactortype = 'NOT_ENABLED' WHERE username = :'u';
\endif
COMMIT;
\echo DONE
SQL
) || true
case "$out" in
    *DONE*) echo "Password set for $user. DHIS2 is stopped: start it with pihx $PIHX_INSTANCE start" ;;
    *NO-SUCH-USER*) die "no DHIS2 user named $user" ;;
    *NO-USER-TABLE*) die "no users or userinfo table with username and password: is this a DHIS2 database?" ;;
    # psql's error lines only (severity and message), never the statement, which holds the password.
    *) die "couldn't set the password: $(printf '%s\n' "$out" | grep -m1 -o 'ERROR: .*' || printf '%s\n' "$out" | head -n 1 | cut -c1-200)" ;;
esac
