# DHIS2_VERSION has no default: an instance must name the version it runs (services/dhis2/scripts/versions),
# so nothing in this repo can change it.
# The Tomcat image's tag: the versions list's tag for DHIS2_VERSION (dhis2-setup checks it). This
# default is 2.42 and 2.43's; an instance on an earlier version sets its own.
DHIS2_TOMCAT_TAG=10.1-jdk17-temurin-noble
DHIS2_HTTP_PORT=8080
# Empty: dhis.conf gets no encryption.password. An instance restored from another sets that one's.
DHIS2_ENCRYPTION_PASSWORD=
DHIS2_MEMORY_LIMIT=4g
DHIS2_JAVA_OPTS=-Xms1g -Xmx3g
# true only on a copy of production (lsdata-test): every start turns off its outbound email, SMS
# gateways and sending jobs (scripts/test-copy.sql). Never set it on production.
DHIS2_TEST_COPY=false
