# PETL reads any of its properties from env by its Spring name (`.` and `-` become `_`, uppercased),
# e.g. DATASOURCES_OPENMRS_CESCI_HOST for datasources.openmrs.cesci.host: set them in petl.env, and
# the petl container gets them. PETL_MYSQL_PASSWORD has no default: the instance must set it.
PETL_IMAGE_NAME=
PETL_IMAGE_TAG=latest
PETL_FULL_REFRESH_JOBS=
PETL_MAX_RETRIES=0
PETL_MYSQL_USER=petl
# serverTimezone: PETL resolves it to the instance's TZ (docs/services.md).
PETL_MYSQL_OPTIONS='autoReconnect=true&sessionVariables=default_storage_engine%3DInnoDB&useUnicode=true&characterEncoding=UTF-8&useLegacyDatetimeCode=false&serverTimezone=${user.timezone}'
# Only for ETLs with a MySQL reporting stage (e.g. apzu-etl): created, and granted to PETL's account.
PETL_MYSQL_REPORTING_DATABASE=
PETL_SQLSERVER_HOST=sqlserver
PETL_SQLSERVER_PORT=1433
PETL_SQLSERVER_USER=petl
# Only for an ETL writing to SQL Server (8+ characters, with 3 of upper case, lower case, digits and symbols).
PETL_SQLSERVER_PASSWORD=
PETL_SQLSERVER_DATABASE=openmrs_reporting
# PETL's MySQL account is created by openmrs-db's accounts setup, and its SQL Server login by
# sqlserver's setup (when the instance has sqlserver), from the PETL_ values above (see their
# compose.yaml). Only what isn't derived is here.
OPENMRS_DB_ACCOUNT_PETL_GRANTS=ALL ON *.*
