# See compose.yaml. The gateway and the stations are in stations.yaml in MODALITY_SIMULATOR_CONFIG_DIR:
# create it before adding the service (README.md).
MODALITY_SIMULATOR_IMAGE_NAME=partnersinhealth/modality-simulator
MODALITY_SIMULATOR_IMAGE_TAG=latest
MODALITY_SIMULATOR_HOST_PORT=8095
# Relative paths are relative to the instance directory.
MODALITY_SIMULATOR_CONFIG_DIR=./modality-simulator-config
MODALITY_SIMULATOR_IMAGE_DIR=./modality-simulator-images
