# See compose.yaml. The region and access key are the gateway's, from AdvaPACS: Configuration >
# Gateways (the secret is shown once; regenerating it replaces the old one). They have no default:
# the instance must set ADVAPACS_GATEWAY_REGION, ADVAPACS_GATEWAY_ACCESS_KEY_ID and
# ADVAPACS_GATEWAY_ACCESS_KEY_SECRET.
ADVAPACS_GATEWAY_IMAGE_NAME=advahealthsolutions/advapacs-gateway
ADVAPACS_GATEWAY_IMAGE_TAG=1.22.1
# AdvaPACS asks for 4 GB for the gateway. The JVM takes a quarter of the limit for its heap unless
# told otherwise.
ADVAPACS_GATEWAY_MEMORY_LIMIT=4g
ADVAPACS_GATEWAY_JAVA_OPTS=-XX:MaxRAMPercentage=75
