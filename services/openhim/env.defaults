# Release tags, not latest, so an upgrade is a deliberate change here (checked with this setup).
OPENHIM_CORE_IMAGE_TAG=v8.5.1
OPENHIM_CONSOLE_IMAGE_TAG=v1.18.2
OPENHIM_MONGO_IMAGE_TAG=4.0
OPENHIM_ADMIN_API_HOST_PORT=8081
OPENHIM_ROUTER_HTTP_HOST_PORT=5001
OPENHIM_CONSOLE_HOST_PORT=9000
# The console's and the admin API's addresses as a browser sees them (see compose.yaml). Also
# OPENHIM_CONSOLE_URL and OPENHIM_CONSOLE_API_PORT, which follow the host ports above (http://localhost:
# OPENHIM_CONSOLE_HOST_PORT and OPENHIM_ADMIN_API_HOST_PORT) unless the instance sets them.
OPENHIM_CONSOLE_API_PROTOCOL=http
OPENHIM_CONSOLE_API_HOST=localhost
OPENHIM_CONSOLE_API_PATH=
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=openhim-password
