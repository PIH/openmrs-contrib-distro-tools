DHIS2_DB_IMAGE_NAME=postgis/postgis
DHIS2_DB_IMAGE_TAG=16-3.5
DHIS2_DB_NAME=dhis
DHIS2_DB_USER=dhis
DHIS2_DB_PORT=5432
DHIS2_DB_MEMORY_LIMIT=2g
# Server options: each DHIS2_DB_OPT_<parameter> becomes -c <parameter>=<value> (see compose.yaml).
# DHIS2's recommended settings; size the memory ones to the host.
DHIS2_DB_OPT_max_locks_per_transaction=96
DHIS2_DB_OPT_jit=off
DHIS2_DB_OPT_max_connections=200
DHIS2_DB_OPT_shared_buffers=1GB
DHIS2_DB_OPT_work_mem=24MB
DHIS2_DB_OPT_maintenance_work_mem=1GB
DHIS2_DB_OPT_temp_buffers=16MB
DHIS2_DB_OPT_effective_cache_size=4GB
DHIS2_DB_OPT_checkpoint_completion_target=0.8
DHIS2_DB_OPT_synchronous_commit=off
DHIS2_DB_OPT_wal_writer_delay=10s
DHIS2_DB_OPT_random_page_cost=1.1
DHIS2_DB_OPT_track_activity_query_size=8192
