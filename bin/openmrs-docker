#!/bin/bash
set -euo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OPENMRS_DOCKER_HOME="${OPENMRS_DOCKER_HOME:-$HOME/openmrs}"
SERVICES_DIR="$TOOL_DIR/docker/services"
MODES_DIR="$TOOL_DIR/docker/modes"

usage() {
    echo "Usage:"
    echo "  $0 create <name>          Create a new instance"
    echo "  $0 list                   List existing instances"
    echo "  $0 <name> <command> [options]"
    echo ""
    echo "Commands (for an existing instance):"
    echo "  initialize              Pre-load a brand-new instance's data volumes (refuses to run if any data volume already exists) -- see 'initialize' below"
    echo "  start                   Start the stack"
    echo "  stop                    Stop the running stack"
    echo "  restart                 Restart the running containers in place (no rebuild, no recreate)"
    echo "  status                  Show the state of this instance's containers"
    echo "  update                  Pull latest images and reconcile the stack (recreates only what changed)"
    echo "  sync                    Refresh this instance's copied service fragments from the tool's current templates"
    echo "  add-service <svc>       Attach a canonical service fragment (e.g. 'add-service reporting-db')"
    echo "  remove-service <svc>    Detach a service fragment and remove its now-orphaned container"
    echo "  run-service <svc> [cmd...]  Run a one-off container for an attached service via 'docker compose run' (e.g. after add-service)"
    echo "  wait                    Block until OpenMRS finishes initializing (up to 60 minutes)"
    echo "  build                   Build the distribution and Docker image from source"
    echo "  pull                    Pull the images this instance would use, without starting anything"
    echo "  logs [service]          Tail the container logs; defaults to every service"
    echo "  destroy                 Stop the stack, delete all volumes, and remove the instance directory"
    echo ""
    echo "initialize: by default, loads both data volumes from SEED_IMAGE_NAME. Each volume's"
    echo "source can instead be set independently via env vars (set on the initialize invocation"
    echo "itself, not persisted to the instance's env file), so a dump/backup can replace the seed"
    echo "image for one or both volumes -- see utils/ (below) for scripts to prepare these paths"
    echo "from an archive or a percona/xtrabackup backup:"
    echo "  RESTORE_MYSQL_DUMP_PATH    mysql/db-data from a plain .sql/.sql.gz dump"
    echo "  RESTORE_MYSQL_DATA_PATH    mysql/db-data from a ready MySQL data directory (physical restore)"
    echo "  RESTORE_OPENMRS_DATA_PATH  openmrs-data from a ready, already-extracted directory"
    echo ""
    echo "Options:"
    echo "  --build        Build the distribution from source before start/update"
    echo "  --dev          Expose debug ports and mount the locally-built distro over"
    echo "                 whatever's in the image (combine with --build to build it first)"
    echo "  --force        Skip the confirmation prompt (destroy only)"
    echo ""
    echo "Environment variable overrides:"
    echo "  OPENMRS_DOCKER_HOME   Where instance directories live (default: \$HOME/openmrs)"
    echo "  OPENMRS_HTTP_PORT     Port OpenMRS is exposed on (default: 8080)"
    echo ""
    echo "create requires OPENMRS_IMAGE_NAME (env var) when the 'openmrs' service is included (the"
    echo "default). OPENMRS_PIH_CONFIG is optional -- leave it unset for a distro that doesn't use a"
    echo "PIH config profile; a distro that does need one will fail at OpenMRS startup if it's missing,"
    echo "not at instance-creation time. DISTRO_SOURCE_DIR is required only for build/--dev/--build,"
    echo "and can be set later by editing the instance's env file."
    echo "Every other create-time setting (ports, memory limits, image tags, etc.) can be"
    echo "overridden the same way create's own defaults are: set it in your shell (or source a"
    echo "file that does) before running create, and that value is used instead of the built-in"
    echo "default. SERVICES=<comma-separated> (default: openmrs-db,openmrs) selects which"
    echo "canonical service fragments to copy into the new instance directory."
    exit 1
}

# Emits the resolved KEY="value" lines from a
# service's docker/services/<svc>.env.defaults template, with each
# ${VAR:-default} expanded against the calling shell's current environment --
# so a value already exported by the caller (or by an instance's env file
# already sourced into this shell, for add-service) wins
render_service_env_defaults() {
    local template="$SERVICES_DIR/$1.env.defaults"
    [ -f "$template" ] || return 0
    eval "cat <<RENDER_SERVICE_ENV_EOF
$(cat "$template")
RENDER_SERVICE_ENV_EOF"
}

[ $# -ge 1 ] || usage

if [ "$1" = "create" ]; then
    NAME="${2:-}"
    [ -z "$NAME" ] && usage
    INSTANCE_DIR="$OPENMRS_DOCKER_HOME/$NAME"
    if [ -e "$INSTANCE_DIR" ]; then
        echo "Instance directory already exists: $INSTANCE_DIR"
        exit 1
    fi
    # Validate all requested service names have matching yaml files BEFORE creating anything.
    # This prevents a half-created directory if any service name is invalid.
    IFS=',' read -ra SERVICE_LIST <<< "${SERVICES:-openmrs-db,openmrs}"
    for svc in "${SERVICE_LIST[@]}"; do
        [ -f "$SERVICES_DIR/$svc.yaml" ] || { echo "No such service '$svc' (looked for $SERVICES_DIR/$svc.yaml)"; exit 1; }
    done
    NEEDS_OPENMRS=false
    for svc in "${SERVICE_LIST[@]}"; do
        [ "$svc" = "openmrs" ] && NEEDS_OPENMRS=true
    done
    if $NEEDS_OPENMRS && [ -z "${OPENMRS_IMAGE_NAME:-}" ]; then
        echo "OPENMRS_IMAGE_NAME must be set to create an instance that includes the 'openmrs' service"
        echo ""
        usage
    fi
    mkdir -p "$INSTANCE_DIR"
    # Every setting below is taken from the calling shell's environment if already
    # set (e.g. `source myenv && openmrs-docker create ...`), falling back to these
    # defaults otherwise.
    {
        cat <<EOF
# instance
TZ="${TZ:-UTC}"
SERVICE_NAME="$NAME"
DISTRO_SOURCE_DIR="${DISTRO_SOURCE_DIR:-}"
# seed
SEED_IMAGE_NAME="${SEED_IMAGE_NAME:-}"
SEED_IMAGE_TAG="${SEED_IMAGE_TAG:-latest}"
EOF
        # Per-service defaults, one block per SERVICES= entry -- see
        # docker/services/<svc>.env.defaults, colocated with that service's
        # compose fragment rather than enumerated here.
        for svc in "${SERVICE_LIST[@]}"; do
            render_service_env_defaults "$svc"
        done
    } > "$INSTANCE_DIR/env"
    # Copy validated service fragments
    for svc in "${SERVICE_LIST[@]}"; do
        cp "$SERVICES_DIR/$svc.yaml" "$INSTANCE_DIR/$svc.yaml"
    done
    echo "Created instance '$NAME' at $INSTANCE_DIR"
    exit 0
fi

if [ "$1" = "list" ]; then
    [ -d "$OPENMRS_DOCKER_HOME" ] && ls "$OPENMRS_DOCKER_HOME"
    exit 0
fi

NAME="$1"
COMMAND="${2:-}"
shift 2 2>/dev/null || true

INSTANCE_DIR="$OPENMRS_DOCKER_HOME/$NAME"
ENV_FILE="$INSTANCE_DIR/env"
[ -f "$ENV_FILE" ] || { echo "No instance found at $INSTANCE_DIR (run '$0 create $NAME' first)"; exit 1; }

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

[ -z "$COMMAND" ] && usage

# add-service/remove-service take a required service name as their one positional argument;
# logs takes the same positional argument, but optionally. Consumed here before the generic
# flag-parsing loop below, which would otherwise reject it as an unknown option.
SERVICE_ARG=""
case "$COMMAND" in
    add-service|remove-service|run-service)
        SERVICE_ARG="${1:-}"
        [ -z "$SERVICE_ARG" ] && { echo "$COMMAND requires a service name"; usage; }
        shift
        ;;
    logs)
        if [ -n "${1:-}" ] && [[ "$1" != --* ]]; then
            SERVICE_ARG="$1"
            shift
        fi
        ;;
esac

BUILD=false
DEV=false
FORCE=false
# run-service forwards its remaining args verbatim as the one-off container's command
# (e.g. ./execute-smoke-tests.sh liberia) -- skip flag validation for it.
if [ "$COMMAND" != "run-service" ]; then
    for arg in "$@"; do
        case "$arg" in
            --build) BUILD=true ;;
            --dev) DEV=true ;;
            --force) FORCE=true ;;
            *) echo "Unknown option: '$arg'"; echo ""; usage ;;
        esac
    done
fi

export SERVICE_NAME="${SERVICE_NAME:-$NAME}"

# Rebuilds COMPOSE_FILES from the instance directory's *current* set of copied
# service fragments plus the dev mode overlay this invocation's flags select. Never includes any
# of the restore-*-volume-from-*.yaml overlays — those are only ever used directly by
# `initialize`; every other command must keep working without them. Called again after
# remove-service deletes a fragment, so the removal is reflected immediately.
compose_files() {
    COMPOSE_FILES=(--env-file "$ENV_FILE")
    for f in "$INSTANCE_DIR"/*.yaml; do
        [ -e "$f" ] || continue
        COMPOSE_FILES+=(-f "$f")
    done
    if $DEV; then
        COMPOSE_FILES+=(-f "$MODES_DIR/dev.yaml")
    fi
}
compose_files

require_distro_source() {
    if [ -z "${DISTRO_SOURCE_DIR:-}" ]; then
        echo "DISTRO_SOURCE_DIR must be set in $ENV_FILE for this command"
        exit 1
    fi
}

build_image() {
    require_distro_source
    cd "$DISTRO_SOURCE_DIR" && mvn clean package -U
    # Always build explicitly rather than relying on `docker compose up -d` to
    # build automatically: when a service has both `image:` and `build:`,
    # Compose prefers pulling the named tag from a registry over building
    # locally, and only falls back to building if the pull fails. Relying on
    # that fallback would silently use whatever's published under OPENMRS_IMAGE_NAME
    # instead of this local build, whenever that tag exists in a reachable
    # registry.
    docker compose "${COMPOSE_FILES[@]}" build
}

start_stack() {
    docker compose "${COMPOSE_FILES[@]}" up -d
}

# Advisory only — never blocks, never prompts, never modifies anything. See the
# design doc's "Discoverability" section for why a blocking prompt was rejected.
warn_on_drift() {
    local drifted=()
    local f canonical
    for f in "$INSTANCE_DIR"/*.yaml; do
        [ -e "$f" ] || continue
        canonical="$SERVICES_DIR/$(basename "$f")"
        [ -e "$canonical" ] || continue  # canonical service renamed/removed - not this check's concern
        cmp -s "$f" "$canonical" || drifted+=("$(basename "$f")")
    done
    if [ ${#drifted[@]} -gt 0 ]; then
        echo "Note: newer service definitions available for: ${drifted[*]}" >&2
        echo "Run '$0 $NAME sync' to update before the next start/update." >&2
    fi
}

sync_services() {
    local f canonical
    for f in "$INSTANCE_DIR"/*.yaml; do
        [ -e "$f" ] || continue
        canonical="$SERVICES_DIR/$(basename "$f")"
        if [ -e "$canonical" ]; then
            cp "$canonical" "$f"
            echo "Synced $(basename "$f")"
        else
            echo "Skipped $(basename "$f") (no canonical service found at $canonical)"
        fi
    done
}

case "$COMMAND" in
    start)
        if $DEV || $BUILD; then require_distro_source; fi
        warn_on_drift
        if $BUILD; then build_image; fi
        start_stack
        ;;
    update)
        if $DEV || $BUILD; then require_distro_source; fi
        warn_on_drift
        if $BUILD; then build_image; fi
        docker compose "${COMPOSE_FILES[@]}" pull
        start_stack
        ;;
    initialize)
        # initialize only runs against a brand-new instance -- check every volume Compose declares.
        # Assigned first (not `for vol in $(...)` directly): set -e does not fire on a failed
        # command substitution inside a for loop's word list, so a failure there would otherwise
        # silently skip this, this command's only protection against clobbering existing data.
        INIT_VOLUMES=$(docker compose "${COMPOSE_FILES[@]}" config --volumes)
        for vol in $INIT_VOLUMES; do
            if docker volume inspect "${SERVICE_NAME}_${vol}" >/dev/null 2>&1; then
                echo "error: ${SERVICE_NAME}_${vol} already exists -- initialize only runs against a brand-new instance with no existing data. Run '$0 $NAME destroy' first if you really want to start over." >&2
                exit 1
            fi
        done

        # Each volume's source is chosen independently, so e.g. db-data can come from a
        # RESTORE_MYSQL_DUMP_PATH dump while openmrs-data still comes from SEED_IMAGE_NAME. Archive
        # extraction and percona/xtrabackup handling happen upstream of this command entirely
        # (see utils/) -- these env vars are always plain, ready-to-use paths.
        DB_SOURCES=0
        DB_RESTORED_FROM_BACKUP=
        if [ -n "${RESTORE_MYSQL_DUMP_PATH:-}" ]; then
            [ -f "$RESTORE_MYSQL_DUMP_PATH" ] || { echo "error: no such file: $RESTORE_MYSQL_DUMP_PATH" >&2; exit 1; }
            # Convert relative to absolute path if needed
            case "$RESTORE_MYSQL_DUMP_PATH" in
                /*) ;;
                *) RESTORE_MYSQL_DUMP_PATH="$(cd "$(dirname "$RESTORE_MYSQL_DUMP_PATH")" && pwd)/$(basename "$RESTORE_MYSQL_DUMP_PATH")" ;;
            esac
            case "$RESTORE_MYSQL_DUMP_PATH" in
                *.gz) export RESTORE_MYSQL_DUMP_FILENAME="dump.sql.gz" ;;
                *)    export RESTORE_MYSQL_DUMP_FILENAME="dump.sql" ;;
            esac
            export RESTORE_MYSQL_DUMP_PATH
            COMPOSE_FILES+=(-f "$MODES_DIR/restore-mysql-volume-from-dump.yaml")
            DB_SOURCES=$((DB_SOURCES + 1))
            DB_RESTORED_FROM_BACKUP=1
        fi
        if [ -n "${RESTORE_MYSQL_DATA_PATH:-}" ]; then
            [ -d "$RESTORE_MYSQL_DATA_PATH" ] || { echo "error: no such directory: $RESTORE_MYSQL_DATA_PATH" >&2; exit 1; }
            # Convert relative to absolute path if needed
            RESTORE_MYSQL_DATA_PATH="$(cd "$RESTORE_MYSQL_DATA_PATH" && pwd)"
            export RESTORE_MYSQL_DATA_PATH
            COMPOSE_FILES+=(-f "$MODES_DIR/restore-mysql-volume-from-data-dir.yaml")
            DB_SOURCES=$((DB_SOURCES + 1))
            DB_RESTORED_FROM_BACKUP=1
        fi
        if [ "$DB_SOURCES" -eq 0 ] && [ -n "${SEED_IMAGE_NAME:-}" ]; then
            COMPOSE_FILES+=(-f "$MODES_DIR/restore-mysql-volume-from-seed.yaml")
            DB_SOURCES=$((DB_SOURCES + 1))
        fi
        [ "$DB_SOURCES" -eq 1 ] || { echo "error: set exactly one of RESTORE_MYSQL_DUMP_PATH, RESTORE_MYSQL_DATA_PATH, or SEED_IMAGE_NAME to initialize the mysql/db-data volume" >&2; exit 1; }

        DATA_SOURCES=0
        if [ -n "${RESTORE_OPENMRS_DATA_PATH:-}" ]; then
            [ -d "$RESTORE_OPENMRS_DATA_PATH" ] || { echo "error: no such directory: $RESTORE_OPENMRS_DATA_PATH" >&2; exit 1; }
            # Convert relative to absolute path if needed
            RESTORE_OPENMRS_DATA_PATH="$(cd "$RESTORE_OPENMRS_DATA_PATH" && pwd)"
            export RESTORE_OPENMRS_DATA_PATH
            COMPOSE_FILES+=(-f "$MODES_DIR/restore-openmrs-data-volume-from-backup.yaml")
            DATA_SOURCES=$((DATA_SOURCES + 1))
        fi
        if [ "$DATA_SOURCES" -eq 0 ] && [ -n "${SEED_IMAGE_NAME:-}" ]; then
            COMPOSE_FILES+=(-f "$MODES_DIR/restore-openmrs-data-volume-from-seed.yaml")
            DATA_SOURCES=$((DATA_SOURCES + 1))
        fi
        # Unlike db-data, openmrs-data is optional to restore/seed here: leaving both
        # RESTORE_OPENMRS_DATA_PATH and SEED_IMAGE_NAME unset is a valid choice -- e.g. restoring
        # a real db-data backup with no matching openmrs-data backup -- and just leaves that
        # volume for OpenMRS's own first-boot module-initializer run to build up from scratch,
        # same as a totally fresh install.

        # db-data already has a real schema but openmrs-data doesn't -- without this, OpenMRS
        # finds no runtime.properties, assumes a fresh install, and tries to CREATE TABLE
        # everything from scratch against a database that already has it (see openmrs.yaml).
        # Respects an explicit OPENMRS_CREATE_TABLES already in the env file.
        if [ -n "$DB_RESTORED_FROM_BACKUP" ] && [ "$DATA_SOURCES" -eq 0 ] && ! grep -q '^OPENMRS_CREATE_TABLES=' "$ENV_FILE"; then
            echo "OPENMRS_CREATE_TABLES=false" >> "$ENV_FILE"
        fi

        # Only openmrs-db (pulling in whichever restore/seed containers the above selected via
        # depends_on) — openmrs itself never needs to run here. openmrs-db's own healthcheck is
        # a genuine completion signal for the DB import: MySQL's entrypoint runs
        # /docker-entrypoint-initdb.d/ against an internal socket-only instance and only starts
        # accepting the TCP connections this healthcheck makes once that finishes — unlike
        # OpenMRS's own curl healthcheck (see the `wait` command below), which flips to
        # "healthy" as soon as Tomcat responds, long before OpenMRS actually finishes starting.
        # db-init isn't declared in services/openmrs-db.yaml, only in
        # restore-mysql-volume-from-seed.yaml, and nothing ever reads it again after this
        # one-time import — removed by name directly since a plain `down` (no -v, to keep
        # openmrs-data/db-data intact) won't catch it. Harmless no-op when this run didn't use it.
        initialize_cleanup() {
            docker compose "${COMPOSE_FILES[@]}" down
            docker volume rm "${SERVICE_NAME}_db-init" >/dev/null 2>&1 || true
        }
        # `|| { ...; }` (not letting these fail bare) so set -e doesn't abort mid-failure and skip
        # the cleanup below -- a failed `up -d` (bad restore input, port conflict, pull failure)
        # would otherwise leave the compose network, containers, and volumes behind.
        if ! docker compose "${COMPOSE_FILES[@]}" up -d openmrs-db; then
            initialize_cleanup
            echo "error: initialize failed -- run '$0 $NAME destroy' before retrying." >&2
            exit 1
        fi
        # fail-on-unhealthy left at its default (false): MySQL doesn't accept TCP connections
        # until its dump import finishes, so a long import legitimately reports unhealthy for a
        # while before succeeding.
        if ! "$TOOL_DIR/utils/wait-for-healthy.sh" --container="${SERVICE_NAME}-openmrs-db" --timeout=600; then
            initialize_cleanup
            echo "error: initialize failed -- run '$0 $NAME destroy' before retrying." >&2
            exit 1
        fi
        initialize_cleanup
        echo "Initialized $NAME."
        ;;
    sync)
        sync_services
        ;;
    add-service)
        dest="$INSTANCE_DIR/$SERVICE_ARG.yaml"
        [ -e "$dest" ] && { echo "error: $SERVICE_ARG already present on $NAME" >&2; exit 1; }
        [ -e "$SERVICES_DIR/$SERVICE_ARG.yaml" ] || { echo "error: no such service '$SERVICE_ARG'" >&2; exit 1; }
        cp "$SERVICES_DIR/$SERVICE_ARG.yaml" "$dest"
        if grep -q '^\s*profiles:' "$dest"; then
            echo "Added $SERVICE_ARG (profiled -- 'start' won't bring it up). Run '$0 $NAME run-service $SERVICE_ARG [cmd...]' to invoke it."
        else
            echo "Added $SERVICE_ARG. Run '$0 $NAME start' to bring it up."
        fi
        # Append this service's default env vars too -- skipping any name already
        # present in the env file (e.g. shared with a service added earlier, or a
        # re-run of add-service) so this never produces a duplicate/conflicting line.
        while IFS= read -r line; do
            if [[ "$line" =~ ^([A-Z_][A-Z0-9_]*)= ]]; then
                grep -q "^${BASH_REMATCH[1]}=" "$ENV_FILE" && continue
            fi
            echo "$line" >> "$ENV_FILE"
        done < <(render_service_env_defaults "$SERVICE_ARG")
        ;;
    remove-service)
        target="$INSTANCE_DIR/$SERVICE_ARG.yaml"
        [ -e "$target" ] || { echo "error: $SERVICE_ARG not present on $NAME" >&2; exit 1; }
        rm "$target"
        compose_files
        docker compose "${COMPOSE_FILES[@]}" up -d --remove-orphans
        echo "Removed $SERVICE_ARG."
        ;;
    run-service)
        [ -e "$INSTANCE_DIR/$SERVICE_ARG.yaml" ] || { echo "error: $SERVICE_ARG not present on $NAME (run 'add-service $SERVICE_ARG' first)" >&2; exit 1; }
        docker compose "${COMPOSE_FILES[@]}" run --rm "$SERVICE_ARG" "$@"
        ;;
    wait)
        OPENMRS_CONTAINER="${SERVICE_NAME}-openmrs"
        docker logs -f "$OPENMRS_CONTAINER" 2>&1 &
        LOGS_PID=$!
        # fail-on-unhealthy=true here (unlike initialize's openmrs-db wait): OpenMRS's own curl
        # healthcheck flips to unhealthy only after genuinely failing to come up, not as a
        # normal side effect of a still-in-progress import the way MySQL's does.
        if "$TOOL_DIR/utils/wait-for-healthy.sh" --container="$OPENMRS_CONTAINER" --timeout=3600 --fail-on-unhealthy=true; then
            kill $LOGS_PID 2>/dev/null || true
            echo "OpenMRS is ready."
            exit 0
        else
            kill $LOGS_PID 2>/dev/null || true
            echo "OpenMRS did not become ready -- see log output above, or '$0 $NAME logs openmrs'."
            exit 1
        fi
        ;;
    build)
        build_image
        ;;
    pull)
        docker compose "${COMPOSE_FILES[@]}" pull
        ;;
    stop)    docker compose "${COMPOSE_FILES[@]}" down --remove-orphans ;;
    restart) docker compose "${COMPOSE_FILES[@]}" restart ;;
    status)  docker compose "${COMPOSE_FILES[@]}" ps ;;
    logs)
        if [ -n "$SERVICE_ARG" ]; then
            docker compose "${COMPOSE_FILES[@]}" logs -f "$SERVICE_ARG"
        else
            docker compose "${COMPOSE_FILES[@]}" logs -f
        fi
        ;;
    destroy)
        if ! $FORCE; then
            echo "This will stop the stack, delete all volumes, and remove $INSTANCE_DIR."
            read -r -p "Are you sure? [y/N] " confirm
            [[ "$confirm" =~ ^[Yy]$ ]] || exit 0
        fi
        # Tolerate failure: an instance whose fragments can't be interpolated (e.g. a required
        # variable left unset in the env file) must still be destroyable -- otherwise a bad
        # fragment permanently traps the instance directory, since destroy aborts before ever
        # reaching the volume and directory cleanup below.
        if ! docker compose "${COMPOSE_FILES[@]}" down -v --remove-orphans; then
            echo "warning: 'docker compose down' failed -- falling back to removing this" >&2
            echo "instance's containers and volumes by compose project label instead." >&2
            # Compose labels everything it creates with the project name, so this reaches
            # the same containers/volumes `down -v` would have, without needing any of the
            # fragments to interpolate successfully.
            docker ps -aq --filter "label=com.docker.compose.project=$SERVICE_NAME" \
                | xargs -r docker rm -f >/dev/null 2>&1 || true
            docker volume ls -q --filter "label=com.docker.compose.project=$SERVICE_NAME" \
                | xargs -r docker volume rm >/dev/null 2>&1 || true
        fi
        # restore-mysql-volume-from-seed.yaml's db-init volume isn't declared in
        # services/openmrs-db.yaml, so an instance that ever ran `initialize` from a seed image
        # would leave it behind here. Removed by name directly rather than relying on -v to
        # catch it, since this destroy invocation has no way to tell whether the instance was
        # ever initialized from a seed in the past.
        docker volume rm "${SERVICE_NAME}_db-init" >/dev/null 2>&1 || true
        if ! rm -rf "$INSTANCE_DIR" 2>/dev/null; then
            # A one-off service (e.g. openmrs-smoke-tests via run-service) may have written
            # root-owned files into a bind-mounted host directory under the instance dir --
            # reclaim ownership via a throwaway root container and retry, rather than
            # requiring sudo or leaving the directory behind. Only attempted as a fallback,
            # so the common case (nothing root-owned) never depends on pulling alpine.
            docker run --rm -v "$INSTANCE_DIR:/target" alpine:3.21 chown -R "$(id -u):$(id -g)" /target
            rm -rf "$INSTANCE_DIR"
        fi
        echo "Removed instance directory $INSTANCE_DIR"
        ;;
    *) echo "Unknown command: '$COMMAND'"; echo ""; usage ;;
esac
