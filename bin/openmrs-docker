#!/bin/sh
# Usage: openmrs-docker create <name> | list | help
#        openmrs-docker <name> <command> [options]   (see 'openmrs-docker help')
#
# The OpenMRS front end on pihx (openmrs/front.py), run through bin/pihx's launcher, so it runs
# like pihx: in pihx-runtime, on instances under PIHX_HOME (default ~/pihx), each from its own
# checkout. What only the host can do happens here first: build and --build run Maven on the
# distribution in the instance's DISTRO_SOURCE_DIR.
set -eu
unset CDPATH

die() { echo "error: $*" >&2; exit 1; }

# This checkout, following a link to this script (e.g. from a bin directory on PATH).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
pihx=$(cd -P "$(dirname "$self")/.." && pwd)/bin/pihx

# Today's `create <name>`, in pihx's order (the instance first).
if [ "${1-}" = create ]; then
    [ $# -eq 2 ] || die "usage: openmrs-docker create <name>"
    set -- "$2" create
fi

PIHX_FRONT_END=openmrs-docker
export PIHX_FRONT_END
unset PIHX_DISTRO_SOURCE_DIR

build=false
case ${2-} in
    build) build=true ;;
    start | update)
        for arg in "$@"; do
            [ "$arg" != --build ] || build=true
        done
        ;;
esac
if $build; then
    # The instance's own value (its instance.env), as its checkout's front end reads it.
    dir=$("$pihx" "$1" _distro-source-dir) || exit
    echo "Building the distribution in $dir (mvn clean package -U)" >&2
    (cd "$dir" && mvn clean package -U) || die "the Maven build in $dir failed"
    PIHX_DISTRO_SOURCE_DIR=$dir
    export PIHX_DISTRO_SOURCE_DIR
fi

exec "$pihx" "$@"
