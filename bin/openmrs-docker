#!/bin/sh
# Usage: openmrs-docker <instance> <command> [args...] | openmrs-docker list | help | version
#
# openmrs-docker is a pihx extension (openmrs/extension.py): pihx's command line, with OpenMRS
# development commands. It runs through bin/pihx's launcher, so it runs like pihx: in pihx-runtime,
# on instances under PIHX_HOME (default ~/pihx), each from its own checkout. What needs the host
# happens here first: build and --build run Maven on the distribution in the instance's
# OPENMRS_DISTRO_DIR, which goes to the launcher as a read-only mount (PIHX_EXTRA_MOUNTS).
set -eu
unset CDPATH

die() { echo "error: $*" >&2; exit 1; }

# This checkout, following a link to this script (e.g. from a bin directory on PATH).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
pihx=$(cd -P "$(dirname "$self")/.." && pwd)/bin/pihx

PIHX_EXTENSION=openmrs.extension
PIHX_EXTRA_MOUNTS=
export PIHX_EXTENSION PIHX_EXTRA_MOUNTS

# build and --build: the command is checked first (its options, the openmrs service, the instance
# lock, an absolute OPENMRS_DISTRO_DIR), so one that would be refused doesn't wait for a long build;
# then Maven builds the distribution here, and its directory is mounted for Compose to send as the
# image's build context.
build=false
case ${2-} in
    build) build=true ;;
    start | update)
        for arg in "$@"; do
            [ "$arg" != --build ] || build=true
        done
        ;;
esac
if $build; then
    name=$1
    shift
    dir=$("$pihx" "$name" _distro-dir "$@") || exit
    set -- "$name" "$@"
    echo "Building the distribution in $dir (mvn clean package -U)" >&2
    (cd "$dir" && mvn clean package -U) || die "the Maven build in $dir failed"
    case $dir in
        *'
'*) die "can't mount a path with a newline in it" ;;
    esac
    PIHX_EXTRA_MOUNTS=$dir
fi

exec "$pihx" "$@"
