#!/bin/sh
# Usage: pihx <instance> <command> [args...] | pihx list | help | version
#
# Runs the pihx package from this checkout inside pihx-runtime, so the host needs only Docker and a
# POSIX shell. The checkout and PIHX_HOME (default ~/pihx) are mounted at their host paths, so paths
# pihx hands to Compose resolve on the host. pihx <instance> ... runs the instance's own checkout
# (its tools link), whichever bin/pihx was typed.
set -eu
# A relative cd would otherwise follow CDPATH and print the directory it picked.
unset CDPATH

die() { echo "error: $*" >&2; exit 1; }

# This checkout, following a link to this script (e.g. from a bin directory on PATH).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
PIHX_TOOLS=$(cd -P "$(dirname "$self")/.." && pwd)

PIHX_HOME=${PIHX_HOME:-$HOME/pihx}
# Made here, not by docker run, which would make it root-owned.
mkdir -p "$PIHX_HOME"
PIHX_HOME=$(cd -P "$PIHX_HOME" && pwd)

# Hand-off: an instance runs the checkout its tools link names. Only for a valid instance name, so
# the argument can't point outside PIHX_HOME. A tools link that resolves nowhere is pihx's to report.
# Once only: the launcher handed to never hands off again, so links can't send it round in a loop.
if [ -z "${PIHX_HANDED_OFF-}" ]; then
    case ${1-} in
        '' | [!a-z0-9]* | *[!a-z0-9_-]*) ;;
        *)
            if instance_tools=$(cd -P "$PIHX_HOME/$1/tools" 2>/dev/null && pwd) \
                    && [ "$instance_tools" != "$PIHX_TOOLS" ]; then
                [ -x "$instance_tools/bin/pihx" ] || die "$PIHX_HOME/$1/tools has no bin/pihx"
                PIHX_HANDED_OFF=1
                export PIHX_HANDED_OFF
                exec "$instance_tools/bin/pihx" "$@"
            fi
            # An instance whose tools link resolves nowhere (the checkout moved or was deleted) has
            # no checkout to run. Python never resolves other instances' links, so this is the one
            # place that says so. use-tools is the fix, and create refuses an existing directory
            # itself.
            case $1:${2-} in
                list:* | help:* | version:* | *:use-tools | *:create) ;;
                *)
                    if [ -d "$PIHX_HOME/$1" ] && [ ! -d "$PIHX_HOME/$1/tools" ]; then
                        die "$PIHX_HOME/$1/tools doesn't resolve to a checkout; point it at one with: pihx $1 use-tools <path>"
                    fi
                    ;;
            esac
            ;;
    esac
fi

# The socket is mounted into the container, so only a local one will do.
docker_host=${DOCKER_HOST:-unix:///var/run/docker.sock}
case $docker_host in
    unix://*) socket=${docker_host#unix://} ;;
    *) die "pihx needs a local Docker socket; DOCKER_HOST is $DOCKER_HOST" ;;
esac
# GNU stat, then BSD (macOS).
socket_gid=$(stat -c %g "$socket" 2>/dev/null || stat -f %g "$socket" 2>/dev/null) \
    || die "can't read the Docker socket $socket"

image=pihx-runtime:$("$PIHX_TOOLS/lib/image-tag.sh" "$PIHX_TOOLS/images/pihx-runtime")
if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "Building $image" >&2
    docker build -q -t "$image" "$PIHX_TOOLS/images/pihx-runtime" >/dev/null \
        || die "couldn't build $image"
fi

# use-tools checks the checkout it is given, so that is mounted too (read-only) when it's elsewhere.
# pihx gets the resolved path (PIHX_USE_TOOLS), the one mounted, not the argument as typed.
unset PIHX_USE_TOOLS
use_tools_mount=
if [ "${2-}" = use-tools ] && [ -n "${3-}" ] && [ -d "$3" ]; then
    use_tools_dir=$(cd -P "$3" && pwd)
    PIHX_USE_TOOLS=$use_tools_dir
    export PIHX_USE_TOOLS
    case $use_tools_dir/ in
        "$PIHX_TOOLS"/* | "$PIHX_HOME"/*) ;;
        *) use_tools_mount=$use_tools_dir:$use_tools_dir:ro ;;
    esac
fi

# From here "$@" is the container's command, so options for docker run can go in front of it.
set -- "$image" python3 -m pihx "$@"
[ -z "$use_tools_mount" ] || set -- -v "$use_tools_mount" "$@"

# The caller's Docker config, for registry credentials (Puppet writes the instance user's). Mounted
# aside, read-only: pihx installs a copy without credential helpers, whose binaries the image lacks,
# and keeps ~/.docker writable for buildx.
unset PIHX_DOCKER_CONFIG
docker_config=${DOCKER_CONFIG:-$HOME/.docker}/config.json
if [ -f "$docker_config" ]; then
    PIHX_DOCKER_CONFIG=/run/pihx/docker-config.json
    export PIHX_DOCKER_CONFIG
    set -- -v "$docker_config:$PIHX_DOCKER_CONFIG:ro" "$@"
fi

# The container's working directory is the caller's when it's mounted; PIHX_CWD carries it anyway,
# so relative paths can be resolved as on the host.
PIHX_CWD=$(pwd -P)
case $PIHX_CWD/ in
    "$PIHX_TOOLS"/* | "$PIHX_HOME"/*) workdir=$PIHX_CWD ;;
    *) workdir=/ ;;
esac

# Every variable the caller has, passed by name (-e NAME) so values, secrets included, stay off the
# command line: `create` captures whatever a service defines or requires (including values with no
# default), and pihx's Python decides which belong in which file. Not passed: what the container sets
# for itself (PATH, HOME, ...), the host's shell state, DOCKER_* (handled above), and Python's and
# the loader's own settings.
export PIHX_TOOLS PIHX_HOME PIHX_CWD
PIHX_RUNTIME_IMAGE=$image
export PIHX_RUNTIME_IMAGE
env_args=
for name in $(awk 'BEGIN { for (k in ENVIRON) print k }' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' |
        grep -Ev '^(PATH|HOME|PWD|OLDPWD|SHLVL|HOSTNAME|_|DOCKER_.*|PYTHON.*|LD_.*)$'); do
    env_args="$env_args -e $name"
done

tty=
[ -t 0 ] && [ -t 1 ] && tty=-t

# Exec, so pihx's exit status is the launcher's. env_args and tty are unquoted on purpose: a list of
# options of variable names, or nothing.
# shellcheck disable=SC2086
exec docker run --rm -i $tty \
    -u "$(id -u):$(id -g)" --group-add "$socket_gid" \
    -v "$socket:/var/run/docker.sock" \
    -v "$PIHX_TOOLS:$PIHX_TOOLS:ro" -v "$PIHX_HOME:$PIHX_HOME" \
    -w "$workdir" \
    -e HOME=/tmp -e PYTHONPATH="$PIHX_TOOLS" -e PYTHONDONTWRITEBYTECODE=1 $env_args \
    "$@"
