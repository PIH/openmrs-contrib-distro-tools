# See docker/services/advapacs-gateway.yaml. The region and access key are the gateway's, from
# AdvaPACS: Configuration > Gateways (the secret is shown once; regenerating it replaces the old one).
ADVAPACS_GATEWAY_IMAGE_NAME="${ADVAPACS_GATEWAY_IMAGE_NAME:-advahealthsolutions/advapacs-gateway}"
ADVAPACS_GATEWAY_IMAGE_TAG="${ADVAPACS_GATEWAY_IMAGE_TAG:-1.21.1}"
ADVAPACS_GATEWAY_REGION="${ADVAPACS_GATEWAY_REGION:?must be set: the region of the gateway, from AdvaPACS (Configuration > Gateways)}"
ADVAPACS_GATEWAY_ACCESS_KEY_ID="${ADVAPACS_GATEWAY_ACCESS_KEY_ID:?must be set: the access key ID of the gateway, from AdvaPACS (Configuration > Gateways)}"
ADVAPACS_GATEWAY_ACCESS_KEY_SECRET="${ADVAPACS_GATEWAY_ACCESS_KEY_SECRET:?must be set: the access key secret of the gateway, from AdvaPACS (Configuration > Gateways)}"
