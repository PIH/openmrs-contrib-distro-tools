# See docker/services/biometrics.yaml. The image is private: the host needs `docker login ghcr.io`.
BIOMETRICS_IMAGE_NAME="${BIOMETRICS_IMAGE_NAME:-ghcr.io/pih/pih-biometrics}"
BIOMETRICS_IMAGE_TAG="${BIOMETRICS_IMAGE_TAG:?must be set: a pih-biometrics image tag, e.g. 1.0.0-SNAPSHOT}"
BIOMETRICS_LICENSE_BASE64="${BIOMETRICS_LICENSE_BASE64:?must be set: the Neurotechnology license file, base64-encoded (base64 -w0 <file>.lic)}"
BIOMETRICS_MATCHING_THRESHOLD="${BIOMETRICS_MATCHING_THRESHOLD:-72}"
BIOMETRICS_MATCHING_SPEED="${BIOMETRICS_MATCHING_SPEED:-LOW}"
BIOMETRICS_TEMPLATE_SIZE="${BIOMETRICS_TEMPLATE_SIZE:-LARGE}"
