PETL_SQLSERVER_DATABASE="${PETL_SQLSERVER_DATABASE:-openmrs_reporting}"
PETL_SQLSERVER_IMAGE_TAG="${PETL_SQLSERVER_IMAGE_TAG:-2019-CU13-ubuntu-20.04}"
# For reaching petl-sqlserver from outside Docker; petl itself uses 1433 inside the instance.
PETL_SQLSERVER_PUBLISHED_PORT="${PETL_SQLSERVER_PUBLISHED_PORT:-${PETL_SQLSERVER_PORT:-1433}}"
PETL_SQLSERVER_PASSWORD="${PETL_SQLSERVER_PASSWORD:?must be set: the SQL Server sa password (8+ characters, with 3 of upper case, lower case, digits and symbols)}"
