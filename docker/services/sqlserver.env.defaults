# container-env: SQLSERVER_LOGIN_
# setup-services: sqlserver-setup
SQLSERVER_IMAGE_TAG="${SQLSERVER_IMAGE_TAG:-2025-latest}"
SQLSERVER_SA_PASSWORD="${SQLSERVER_SA_PASSWORD:?must be set: the SQL Server sa password (8+ characters, with 3 of upper case, lower case, digits and symbols)}"
# For reaching SQL Server from outside Docker (reports, the data team); the instance's services use 1433.
SQLSERVER_PUBLISHED_PORT="${SQLSERVER_PUBLISHED_PORT:-1433}"
# Databases to create (space-separated); a login's own databases are created too.
SQLSERVER_DATABASES="${SQLSERVER_DATABASES:-}"
SQLSERVER_MEMORY_MB="${SQLSERVER_MEMORY_MB:-2048}"
SQLSERVER_TEMPDB_FILES="${SQLSERVER_TEMPDB_FILES:-4}"
SQLSERVER_MEMORY_LIMIT="${SQLSERVER_MEMORY_LIMIT:-3g}"
# Logins: SQLSERVER_LOGIN_<ID>_USER, _PASSWORD, _DATABASES (space-separated), _ROLE (default db_owner)
