# container-env: OPENMRS_DB_OPT_ OPENMRS_DB_ACCOUNT_
OPENMRS_DB_IMAGE_NAME="${OPENMRS_DB_IMAGE_NAME:-mysql}"
OPENMRS_DB_IMAGE_TAG="${OPENMRS_DB_IMAGE_TAG:-5.6}"
OPENMRS_DB_USER="${OPENMRS_DB_USER:-openmrs}"
OPENMRS_DB_PASSWORD="${OPENMRS_DB_PASSWORD:-openmrs}"
OPENMRS_DB_ROOT_PASSWORD="${OPENMRS_DB_ROOT_PASSWORD:-openmrs}"
OPENMRS_DB_PORT="${OPENMRS_DB_PORT:-3306}"
OPENMRS_DB_MEMORY_LIMIT="${OPENMRS_DB_MEMORY_LIMIT:-2g}"
# Server options: each OPENMRS_DB_OPT_<option> becomes --<option>=<value> (see openmrs-db.yaml)
OPENMRS_DB_OPT_character_set_server="${OPENMRS_DB_OPT_character_set_server:-utf8}"
OPENMRS_DB_OPT_collation_server="${OPENMRS_DB_OPT_collation_server:-utf8_general_ci}"
OPENMRS_DB_OPT_max_allowed_packet="${OPENMRS_DB_OPT_max_allowed_packet:-1G}"
OPENMRS_DB_OPT_innodb_buffer_pool_size="${OPENMRS_DB_OPT_innodb_buffer_pool_size:-1G}"
OPENMRS_DB_OPT_net_read_timeout="${OPENMRS_DB_OPT_net_read_timeout:-3600}"
OPENMRS_DB_OPT_net_write_timeout="${OPENMRS_DB_OPT_net_write_timeout:-3600}"
OPENMRS_DB_OPT_log_bin_trust_function_creators="${OPENMRS_DB_OPT_log_bin_trust_function_creators:-1}"
