OPENMRS_IMAGE_NAME="$OPENMRS_IMAGE_NAME"
OPENMRS_IMAGE_TAG="${OPENMRS_IMAGE_TAG:-latest}"
OPENMRS_PIH_CONFIG="$OPENMRS_PIH_CONFIG"
OPENMRS_HTTP_PORT="${OPENMRS_HTTP_PORT:-8080}"
OPENMRS_DEBUG_PORT="${OPENMRS_DEBUG_PORT:-1044}"
OPENMRS_MEMORY_LIMIT="${OPENMRS_MEMORY_LIMIT:-4g}"
OPENMRS_JAVA_MEMORY_OPTS="${OPENMRS_JAVA_MEMORY_OPTS:--Xms512m -Xmx2g -XX:NewSize=128m}"
OPENMRS_ACTIVITYLOG_ENABLED="${OPENMRS_ACTIVITYLOG_ENABLED:-false}"
