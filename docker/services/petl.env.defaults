PETL_IMAGE_NAME="${PETL_IMAGE_NAME:-}"
# PETL_BACKUP_PASSWORD is deliberately NOT set here: it's an invocation-time secret for
# 'restore --from-dump|--from-percona' (see README), not a persistent per-instance setting. Sourcing
# an empty default into every instance's env file would silently clobber a caller-supplied value on
# every subsequent command, since this script unconditionally re-sources that file on every invocation.
PETL_IMAGE_TAG="${PETL_IMAGE_TAG:-latest}"
PETL_FULL_REFRESH_JOBS="${PETL_FULL_REFRESH_JOBS:-}"
PETL_MAX_RETRIES="${PETL_MAX_RETRIES:-0}"
PETL_MYSQL_USER="${PETL_MYSQL_USER:-${OPENMRS_DB_USER:-openmrs}}"
PETL_MYSQL_PASSWORD="${PETL_MYSQL_PASSWORD:-${OPENMRS_DB_PASSWORD:-openmrs}}"
PETL_MYSQL_ROOT_PASSWORD="${PETL_MYSQL_ROOT_PASSWORD:-}"
PETL_SQLSERVER_HOST="${PETL_SQLSERVER_HOST:-petl-sqlserver}"
PETL_SQLSERVER_PORT="${PETL_SQLSERVER_PORT:-1433}"
PETL_SQLSERVER_USER="${PETL_SQLSERVER_USER:-sa}"
PETL_SQLSERVER_PASSWORD="${PETL_SQLSERVER_PASSWORD:-9%4qP7b2H!%J}"
