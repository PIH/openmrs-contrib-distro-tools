# container-env: PETL_ DATASOURCES_ SPRING_ LOGGING_
# run-service: holds-lock
# PETL reads any of its properties from env by its Spring name (`.` and `-` become `_`, uppercased),
# e.g. DATASOURCES_OPENMRS_CESCI_HOST for datasources.openmrs.cesci.host; the petl container gets
# env's lines with these prefixes.
PETL_IMAGE_NAME="${PETL_IMAGE_NAME:-}"
PETL_IMAGE_TAG="${PETL_IMAGE_TAG:-latest}"
PETL_FULL_REFRESH_JOBS="${PETL_FULL_REFRESH_JOBS:-}"
PETL_MAX_RETRIES="${PETL_MAX_RETRIES:-0}"
PETL_MYSQL_USER="${PETL_MYSQL_USER:-petl}"
PETL_MYSQL_PASSWORD="${PETL_MYSQL_PASSWORD:?must be set: the password for the PETL MySQL account}"
# JDBC options for PETL's MySQL datasources (the ETL's application-docker.yml reads them). serverTimezone
# stays a placeholder that PETL resolves to its JVM's zone (the instance's TZ): without it, MySQL
# Connector/J 8.0 goes by the server's zone abbreviation, refusing e.g. EDT and taking CST as Chicago.
PETL_MYSQL_OPTIONS="${PETL_MYSQL_OPTIONS:-autoReconnect=true&sessionVariables=default_storage_engine%3DInnoDB&useUnicode=true&characterEncoding=UTF-8&useLegacyDatetimeCode=false&serverTimezone=\${user.timezone\}}"
# Only for ETLs with a MySQL reporting stage (e.g. apzu-etl): created, and granted to PETL's account.
PETL_MYSQL_REPORTING_DATABASE="${PETL_MYSQL_REPORTING_DATABASE:-}"
PETL_SQLSERVER_HOST="${PETL_SQLSERVER_HOST:-sqlserver}"
PETL_SQLSERVER_PORT="${PETL_SQLSERVER_PORT:-1433}"
PETL_SQLSERVER_USER="${PETL_SQLSERVER_USER:-petl}"
# Only for an ETL writing to SQL Server (8+ characters, with 3 of upper case, lower case, digits and symbols).
PETL_SQLSERVER_PASSWORD="${PETL_SQLSERVER_PASSWORD:-}"
PETL_SQLSERVER_DATABASE="${PETL_SQLSERVER_DATABASE:-openmrs_reporting}"
# PETL's MySQL account (openmrs-db-accounts) and SQL Server login (sqlserver-setup, when the instance
# has sqlserver). Change them together with the PETL_ values above.
OPENMRS_DB_ACCOUNT_PETL_USER="${OPENMRS_DB_ACCOUNT_PETL_USER:-${PETL_MYSQL_USER}}"
OPENMRS_DB_ACCOUNT_PETL_PASSWORD="${OPENMRS_DB_ACCOUNT_PETL_PASSWORD:-${PETL_MYSQL_PASSWORD}}"
OPENMRS_DB_ACCOUNT_PETL_GRANTS="${OPENMRS_DB_ACCOUNT_PETL_GRANTS:-ALL ON *.*}"
OPENMRS_DB_ACCOUNT_PETL_DATABASES="${OPENMRS_DB_ACCOUNT_PETL_DATABASES:-${PETL_MYSQL_REPORTING_DATABASE}}"
SQLSERVER_LOGIN_PETL_USER="${SQLSERVER_LOGIN_PETL_USER:-${PETL_SQLSERVER_USER}}"
SQLSERVER_LOGIN_PETL_PASSWORD="${SQLSERVER_LOGIN_PETL_PASSWORD:-${PETL_SQLSERVER_PASSWORD}}"
SQLSERVER_LOGIN_PETL_DATABASES="${SQLSERVER_LOGIN_PETL_DATABASES:-${PETL_SQLSERVER_DATABASE}}"
