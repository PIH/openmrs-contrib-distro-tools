# See docker/services/openhim-advapacs-mediator.yaml for what these are used for.
ADVAPACS_MEDIATOR_IMAGE_NAME="${ADVAPACS_MEDIATOR_IMAGE_NAME:-partnersinhealth/openhim-advapacs-mediator}"
ADVAPACS_MEDIATOR_IMAGE_TAG="${ADVAPACS_MEDIATOR_IMAGE_TAG:-latest}"
ADVAPACS_MEDIATOR_LOG_LEVEL="${ADVAPACS_MEDIATOR_LOG_LEVEL:-info}"
ADVAPACS_MEDIATOR_INBOUND_SECRET="${ADVAPACS_MEDIATOR_INBOUND_SECRET:-}"
ADVAPACS_MEDIATOR_ORDER_INGESTION_MODE="${ADVAPACS_MEDIATOR_ORDER_INGESTION_MODE:-poll}"
ADVAPACS_MEDIATOR_ORDER_POLL_INTERVAL_MS="${ADVAPACS_MEDIATOR_ORDER_POLL_INTERVAL_MS:-15000}"
ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_ID="${ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_ID:-openmrs}"
ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_PASSWORD="${ADVAPACS_MEDIATOR_OPENHIM_INBOUND_CLIENT_PASSWORD:-}"
OPENMRS_BASE_URL="${OPENMRS_BASE_URL:-http://openmrs:8080/openmrs}"
OPENMRS_FHIR_PATH="${OPENMRS_FHIR_PATH:-/ws/fhir2/R4}"
OPENMRS_USERNAME="${OPENMRS_USERNAME:-}"
OPENMRS_PASSWORD="${OPENMRS_PASSWORD:-}"
ADVAPACS_PATIENT_IDENTIFIER_SYSTEM="${ADVAPACS_PATIENT_IDENTIFIER_SYSTEM:-}"
ADVAPACS_BASE_URL="${ADVAPACS_BASE_URL:-https://usa1.api.integration.advapacs.com/fhir/R5}"
ADVAPACS_CLIENT_ID="${ADVAPACS_CLIENT_ID:-}"
ADVAPACS_CLIENT_SECRET="${ADVAPACS_CLIENT_SECRET:-}"
ADVAPACS_WEBHOOK_SECRET="${ADVAPACS_WEBHOOK_SECRET:-}"
