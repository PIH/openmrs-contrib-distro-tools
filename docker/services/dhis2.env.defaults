# container-env dhis2-setup: DHIS2_
# capture-env: DHIS2_CONF_
# setup-services: dhis2-setup
DHIS2_VERSION="${DHIS2_VERSION:?DHIS2_VERSION must be set for the dhis2 service}"
DHIS2_IMAGE_NAME="${DHIS2_IMAGE_NAME:-tomcat}"
DHIS2_IMAGE_TAG="${DHIS2_IMAGE_TAG:?DHIS2_IMAGE_TAG must be set for the dhis2 service (the Tomcat tag for DHIS2_VERSION in docker/dhis2/upgrade-path)}"
DHIS2_HTTP_PORT="${DHIS2_HTTP_PORT:-8080}"
DHIS2_BASE_URL="${DHIS2_BASE_URL:-http://localhost:${DHIS2_HTTP_PORT}/dhis}"
DHIS2_ENCRYPTION_PASSWORD="${DHIS2_ENCRYPTION_PASSWORD:-}"
DHIS2_MEMORY_LIMIT="${DHIS2_MEMORY_LIMIT:-4g}"
DHIS2_JAVA_OPTS="${DHIS2_JAVA_OPTS:--Xms1g -Xmx3g}"
