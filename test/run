#!/bin/bash
# Runs this project's test suite. Usage:
#   test/run [static|args|integration|all|<test file or dir>] [extra bats args...]
#   test/run unit [extra unittest args...]
#
# unit runs the Python unit tests (pihx's and openmrs/'s) inside pihx-runtime, so needs only docker;
# all runs it first. The other layers need docker, git, jq, curl and perl: bats and GNU parallel are
# fetched at pinned versions into test/.deps on first run. Tests run TEST_JOBS at a time (default:
# the number of CPUs, up to 8; TEST_JOBS=1 runs them one at a time). Every test names its Docker
# resources after its own suite-wide number, so they don't collide. All of them start with this run's
# prefix, pihxtest<pid of test/run>: if the run is killed, a trap removes them, and the next run removes
# those of any run that died without it (kill -9, a lost machine).
set -euo pipefail

TEST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$TEST_DIR/.." && pwd)"
DEPS_DIR="$TEST_DIR/.deps"

# Lowercase letters and digits only: it's also a Compose project name. test/helpers.bash uses it as is.
export RUN_PREFIX="pihxtest$$"

# Removes the containers, then volumes, then networks whose names match <regex>.
remove_matching() { # <regex>
    local ids
    ids=$(docker ps -aq --filter "name=$1") && [ -n "$ids" ] && docker rm -f $ids >/dev/null 2>&1
    ids=$(docker volume ls -q --filter "name=$1") && [ -n "$ids" ] && docker volume rm -f $ids >/dev/null 2>&1
    ids=$(docker network ls -q --filter "name=$1") && [ -n "$ids" ] && docker network rm $ids >/dev/null 2>&1
    return 0
}

# Removes the Docker resources of earlier runs (pihxtest<pid>-..., or odt<pid>-... from before the
# rename) whose test/run process is gone. A prefix whose pid is alive, or anything else, is left alone.
sweep_stale() {
    local names name token pid stale=()
    names=$( { docker ps -a --format '{{.Names}}'; docker volume ls -q; docker network ls --format '{{.Name}}'; } \
        2>/dev/null | grep -E '^(pihxtest|odt)[0-9]+-' || true)
    while read -r token; do
        [ -n "$token" ] || continue
        pid="${token#pihxtest}"; pid="${pid#odt}"
        kill -0 "$pid" 2>/dev/null || [ -d "/proc/$pid" ] || stale+=("$token")
    done < <(sed -E 's/^((pihxtest|odt)[0-9]+)-.*/\1/' <<<"$names" | sort -u)
    [ "${#stale[@]}" -gt 0 ] || return 0
    for name in "${stale[@]}"; do
        remove_matching "^${name}-"
    done
    echo "removed leftover Docker resources of ${#stale[@]} killed test run(s): ${stale[*]}"
}

# Kills <pid> and everything it started.
kill_tree() {
    local child
    for child in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$child"; done
    kill -TERM "$1" 2>/dev/null || true
}

# Only runs when executed, so the functions above can be sourced to try them by hand.
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

# Runs the Python unit tests (pihx's, and the openmrs-docker extension's) in pihx-runtime, the image pihx
# itself runs in, building it if missing.
run_unit() {
    local image dir status=0
    image="partnersinhealth/pihx-runtime:$("$REPO_ROOT/utils/hash-directory.sh" "$REPO_ROOT/images/pihx-runtime")"
    docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null 2>&1 \
        || docker build -q -t "$image" "$REPO_ROOT/images/pihx-runtime" >/dev/null
    for dir in pihx/tests openmrs/tests; do
        docker run --rm -u "$(id -u):$(id -g)" -v "$REPO_ROOT:$REPO_ROOT:ro" -w "$REPO_ROOT" \
            -e PYTHONDONTWRITEBYTECODE=1 "$image" python3 -m unittest discover -s "$dir" -t . "$@" \
            || status=1
    done
    return "$status"
}

fetch() {
    local repo=$1 tag=$2 dir
    dir="$DEPS_DIR/$(basename "$1")"
    if [ ! -d "$dir" ] || [ "$(git -C "$dir" describe --tags 2>/dev/null)" != "$tag" ]; then
        rm -rf "$dir"
        git clone -q --depth 1 --branch "$tag" "https://github.com/$repo.git" "$dir" 2>/dev/null
    fi
}

LAYER="${1:-all}"
[ $# -gt 0 ] && shift
case "$LAYER" in
    unit) run_unit "$@"; exit ;;
    static|args|integration) TARGETS=("$TEST_DIR/$LAYER") ;;
    all) run_unit; TARGETS=("$TEST_DIR/static" "$TEST_DIR/args" "$TEST_DIR/integration") ;;
    *)
        if [ -e "$LAYER" ]; then
            TARGETS=("$LAYER")
        elif [ -e "$TEST_DIR/$LAYER" ]; then
            TARGETS=("$TEST_DIR/$LAYER")
        else
            echo "usage: $0 [unit|static|args|integration|all|<test file or dir>] [bats args...]" >&2
            exit 1
        fi
        ;;
esac

fetch bats-core/bats-core v1.14.0
fetch bats-core/bats-support v0.3.0
fetch bats-core/bats-assert v2.2.4

# bats runs tests in parallel through GNU parallel, a single perl script.
PARALLEL_VERSION=20240922
PARALLEL_SHA256=63210715e8b7c5e129e098f333cd7cdd5fc7a2f325e8e0fb9ed6edba9f1acbc4
if [ ! -x "$DEPS_DIR/parallel/parallel" ] || [ "$(cat "$DEPS_DIR/parallel/VERSION" 2>/dev/null)" != "$PARALLEL_VERSION" ]; then
    rm -rf "$DEPS_DIR/parallel" && mkdir -p "$DEPS_DIR/parallel"
    # GNU's own servers are sometimes unreachable for hours; the checksum makes any mirror safe.
    for gnu in https://ftp.gnu.org/gnu https://mirrors.kernel.org/gnu https://mirrors.ocf.berkeley.edu/gnu; do
        curl -fsSL --connect-timeout 15 -o "$DEPS_DIR/parallel/parallel.tar.bz2" \
            "$gnu/parallel/parallel-$PARALLEL_VERSION.tar.bz2" && break
        echo "couldn't fetch GNU parallel from $gnu, trying the next mirror" >&2
    done
    echo "$PARALLEL_SHA256  $DEPS_DIR/parallel/parallel.tar.bz2" | { sha256sum -c --quiet - 2>/dev/null || shasum -a 256 -c --quiet -; }
    tar xjf "$DEPS_DIR/parallel/parallel.tar.bz2" -C "$DEPS_DIR/parallel" --strip-components=2 "parallel-$PARALLEL_VERSION/src/parallel"
    rm "$DEPS_DIR/parallel/parallel.tar.bz2"
    echo "$PARALLEL_VERSION" > "$DEPS_DIR/parallel/VERSION"
fi
export PATH="$DEPS_DIR/parallel:$PATH" PARALLEL=--will-cite

# Pulled up front: a test that pulls one itself gets Docker's pull progress in the output it checks.
# shellcheck source=../utils/lib/images.sh
. "$TEST_DIR/../utils/lib/images.sh"
for image in "$ALPINE_IMAGE" "$P7ZIP_IMAGE" "$PERCONA_IMAGE" mysql:5.6 mysql:8.0 mariadb:11.4 \
        mcr.microsoft.com/mssql/server:2025-latest; do
    docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null
done

if [ -z "${TEST_JOBS:-}" ]; then
    TEST_JOBS=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
    [ "$TEST_JOBS" -le 8 ] || TEST_JOBS=8
fi
JOBS_ARGS=()
[ "$TEST_JOBS" -gt 1 ] && JOBS_ARGS=(--jobs "$TEST_JOBS")

sweep_stale

# Every test cleans up after itself; this covers a run that is killed (Ctrl-C, a closed terminal, a
# cancelled build). bats runs in the background so a signal reaches the traps at once, not after it ends.
FINISHED=false
cleanup() {
    FINISHED=true
    if [ -n "${BATS_PID:-}" ]; then kill_tree "$BATS_PID"; wait "$BATS_PID" 2>/dev/null || true; fi
    remove_matching "^${RUN_PREFIX}[-_]"
}
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 129' HUP
trap '$FINISHED || cleanup' EXIT

"$DEPS_DIR/bats-core/bin/bats" --timing "${JOBS_ARGS[@]}" "$@" "${TARGETS[@]}" &
BATS_PID=$!
status=0
wait "$BATS_PID" || status=$?
FINISHED=true
exit "$status"
